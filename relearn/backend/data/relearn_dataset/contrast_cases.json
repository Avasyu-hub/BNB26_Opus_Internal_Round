    "concept": "negative-factor distribution",
    "accidental_case": {
      "question": "-2(x+0)=10",
      "correct_answer": "x=-5",
      "faulty_response": "x=-5",
      "explanation": "The omitted effect on the zero term changes nothing."
    },
    "failure_case": {
      "question": "-2(x+3)=10",
      "correct_answer": "x=-8",
      "faulty_response": "x=-7/2",
      "explanation": "Faulty expansion -2x+3=10 gives x=-7/2."
    }
  },
  {
